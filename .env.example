# Copy this file to `.env.local` and fill in real values.
#
#   cp .env.example .env.local
#
# `.env.local` is gitignored. Never commit real keys, and never paste them into
# logs, issues, or chat transcripts.

# ---------------------------------------------------------------------------
# Required - the app will not build or run correctly without these
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
# Supabase Dashboard -> Settings -> API -> Project URL
# NEXT_PUBLIC_ vars are inlined into the client bundle at build time, so this
# must be present at BUILD time, not just at runtime.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key (safe to expose to the browser - row level security
# governs access). Dashboard -> Settings -> API -> Project API keys -> anon
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OpenAI API key. Server-side only: used for chat, workout generation and the
# realtime voice coach. https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Optional - these features degrade gracefully when unset
# ---------------------------------------------------------------------------

# Mem0 API key, for long-term memory across conversations.
# https://app.mem0.ai -> API Keys
# When unset, memory is disabled and Logan starts fresh each session.
MEM0_API_KEY=

# Set to "false" to force-disable the memory layer even when MEM0_API_KEY is
# set. Handy for local testing. Defaults to enabled.
ENABLE_MEMORY=

# Set to "true" to expose in-app developer tools (chat reset, memory inspector).
# Leave unset in production: the reset tool destroys the user's saved profile.
NEXT_PUBLIC_ENABLE_DEV_TOOLS=

# Personal health agent. No secret may use the NEXT_PUBLIC_ prefix.
OPENAI_HEALTH_MODEL=gpt-4.1-mini
# Canonical origin for consent redirects and origin checks (no trailing slash).
APP_URL=http://localhost:3000
# Required for official Garmin sync: obtain through your approved Garmin app.
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
# Exactly 64 hex characters (32 random bytes); stable across server restarts.
GARMIN_TOKEN_ENCRYPTION_KEY=
# Server-only; used for the encrypted Garmin connection table, never browser code.
SUPABASE_SERVICE_ROLE_KEY=
